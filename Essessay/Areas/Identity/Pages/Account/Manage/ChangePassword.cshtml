@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="card-title">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="card mt-4 max-w-lg space-y-4">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

    <div>
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <input asp-for="Input.OldPassword" class="form-input" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
        <span asp-validation-for="Input.OldPassword" class="field-error"></span>
    </div>

    <div>
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <input asp-for="Input.NewPassword" class="form-input" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
        <span asp-validation-for="Input.NewPassword" class="field-error"></span>
    </div>

    <div>
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn-primary w-full">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
