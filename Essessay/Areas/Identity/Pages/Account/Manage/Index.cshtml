@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="card-title">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post" class="card mt-4 max-w-lg space-y-4">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

    <div>
        <label asp-for="Username" class="form-label"></label>
        <input asp-for="Username" class="form-input" placeholder="Please choose your username." disabled />
    </div>

    <div>
        <label asp-for="Input.PhoneNumber" class="form-label"></label>
        <input asp-for="Input.PhoneNumber" class="form-input" placeholder="Please enter your phone number." />
        <span asp-validation-for="Input.PhoneNumber" class="field-error"></span>
    </div>

    <button id="update-profile-button" type="submit" class="btn-primary w-full">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
