@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="card-title">@ViewData["Title"]</h3>

<div class="mt-4 max-w-lg space-y-4">
    <p class="text-sm text-gray-600 dark:text-gray-300">Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
    <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Deleting this data will permanently remove your account, and this cannot be recovered.</p>

    <div class="flex flex-wrap gap-2">
        <form id="download-data" asp-page="DownloadPersonalData" method="post" class="inline">
            <button class="btn-secondary" type="submit">Download</button>
        </form>
        <a id="delete" asp-page="DeletePersonalData" class="btn-danger">Delete</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
