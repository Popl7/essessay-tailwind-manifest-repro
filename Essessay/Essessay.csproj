<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- No Tailwind CLI, no external process at all. A built-in, synchronous
         MSBuild task writes wwwroot/css/site.css in-process. Same bug as the
         Tailwind-based version on `main` — see the README and
         https://github.com/dotnet/aspnetcore/issues/68641 — which shows this
         has nothing to do with Tailwind or with running an external process;
         it's purely about a BeforeBuild-hooked target writing into wwwroot. -->
    <ItemGroup>
        <SiteCssInput Include="Views/**/*.cshtml" />
    </ItemGroup>

    <Target Name="GenerateSiteCss" BeforeTargets="BeforeBuild" Inputs="@(SiteCssInput)" Outputs="$(BaseIntermediateOutputPath)sitecss.stamp;wwwroot/css/site.css">
        <MakeDir Directories="wwwroot/css" />
        <WriteLinesToFile File="wwwroot/css/site.css" Lines=".max-w-lg{max-width:32rem}.border-emerald-500{border-color:#10b981}body{background:#f1f5f9}" Overwrite="true" />
        <Touch Files="$(BaseIntermediateOutputPath)sitecss.stamp" AlwaysCreate="true" />
    </Target>

</Project>
