<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- The exact pattern from Microsoft's own official guidance for hooking
         asset generation into the static web assets pipeline:
         https://devblogs.microsoft.com/dotnet/build-client-web-assets-for-your-razor-class-library/
         BeforeTargets="AssignTargetPaths" (not BeforeBuild), the generated file
         written to $(IntermediateOutputPath) rather than directly into wwwroot,
         and linked in via an explicit <Content Include=".." Link="wwwroot/.." />
         item rather than relying on the wwwroot/** wildcard glob to notice a
         file that appeared on disk after project evaluation. Testing whether
         following this exactly (not just the BeforeTargets name) avoids the
         bug — see the README and https://github.com/dotnet/aspnetcore/issues/68641. -->
    <ItemGroup>
        <SiteCssInput Include="Views/**/*.cshtml" />
    </ItemGroup>

    <Target Name="GenerateSiteCss" BeforeTargets="AssignTargetPaths" Inputs="@(SiteCssInput)" Outputs="$(IntermediateOutputPath)sitecss.complete.txt">
        <WriteLinesToFile File="$(IntermediateOutputPath)site.css" Lines=".max-w-lg{max-width:32rem}.border-emerald-500{border-color:#10b981}body{background:#f1f5f9}" Overwrite="true" />
        <ItemGroup>
            <_GeneratedCss Include="$(IntermediateOutputPath)site.css" />
            <Content Include="@(_GeneratedCss)" Link="wwwroot/css/%(_GeneratedCss.Filename)%(_GeneratedCss.Extension)" />
            <FileWrites Include="@(_GeneratedCss)" />
            <FileWrites Include="$(IntermediateOutputPath)sitecss.complete.txt" />
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)sitecss.complete.txt" Lines="@(_GeneratedCss)" Overwrite="true" />
    </Target>

</Project>
