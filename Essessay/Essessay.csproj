<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- The exact shape taught by real "add Tailwind to ASP.NET Core" tutorials —
         see https://github.com/dotnet/aspnetcore/issues/68641#issuecomment-5342134333
         for the specific posts this mirrors, e.g.:

           <Target Name="Tailwind" BeforeTargets="Build">
               <Exec Command="npx @tailwindcss/cli -i ./css/site.css -o ../wwwroot/css/site.css" />
           </Target>

         BeforeTargets="Build" (not BeforeBuild, not AssignTargetPaths), no
         Inputs/Outputs incremental check, no Content/Link item — just a task
         that writes straight into wwwroot, exactly as taught. This one uses
         WriteLinesToFile instead of shelling out to npx/tailwindcss (no Node
         dependency, and we've already shown in this repo that Tailwind CLI vs.
         a trivial write makes no difference), but it's otherwise the same shape
         a developer following one of those posts on .NET 10 would end up with. -->
    <Target Name="Tailwind" BeforeTargets="Build">
        <MakeDir Directories="wwwroot/css" />
        <WriteLinesToFile File="wwwroot/css/site.css" Lines=".max-w-lg{max-width:32rem}.border-emerald-500{border-color:#10b981}body{background:#f1f5f9}" Overwrite="true" />
    </Target>

</Project>
