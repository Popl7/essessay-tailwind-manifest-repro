<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!-- EXPERIMENT: hook the exact target that consumes @(Content) for wwwroot/**
         discovery — ResolveProjectStaticWebAssets — instead of the shared
         AssignTargetPaths anchor it itself hooks (which makes any BeforeTargets=
         "AssignTargetPaths" target an *unordered* sibling of it, per MSBuild's
         BeforeTargets semantics: no ordering is guaranteed between two targets
         that share one anchor). BeforeTargets="ResolveProjectStaticWebAssets"
         gives a real, guaranteed dependency edge onto that specific target.

         Deliberately NO explicit <Content Include> item here — writing straight
         into wwwroot/css/site.css, same as every other broken variant in this
         repo. Testing whether guaranteed ordering alone (without registering an
         explicit Content item) is enough, since ResolveProjectStaticWebAssets's
         CandidateAssets="@(Content->Distinct())" only ever filters the existing
         Content item collection — it doesn't rescan disk. See
         https://github.com/dotnet/sdk/issues/55883. -->
    <ItemGroup>
        <SiteCssInput Include="Views/**/*.cshtml" />
    </ItemGroup>

    <Target Name="GenerateSiteCss" BeforeTargets="ResolveProjectStaticWebAssets" Inputs="@(SiteCssInput)" Outputs="$(BaseIntermediateOutputPath)sitecss.stamp;wwwroot/css/site.css">
        <MakeDir Directories="wwwroot/css" />
        <WriteLinesToFile File="wwwroot/css/site.css" Lines=".max-w-lg{max-width:32rem}.border-emerald-500{border-color:#10b981}body{background:#f1f5f9}" Overwrite="true" />
        <Touch Files="$(BaseIntermediateOutputPath)sitecss.stamp" AlwaysCreate="true" />
    </Target>

</Project>
