@model Essessay.Models.ContactForm
@{
    ViewData["Title"] = "Forms";
}

<div class="mx-auto max-w-2xl">
    <h1 class="page-title">Real forms, not signal soup</h1>
    <p class="page-lead">
        <code class="code-inline">contentType: 'form'</code> posts an actual
        <code class="code-inline">&lt;form&gt;</code> element instead of the signal tree, so existing
        MVC models, validation and antiforgery keep working. The lower cards show the JSON side:
        filtering which signals get sent, and answering without SSE at all.
    </p>

    <div class="mt-6 space-y-6">

        @* ── 1. The form ───────────────────────────────────────────────────── *@
        <div class="card space-y-4">
            <h2 class="card-title">1. Post a form element</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300">
                No <code class="code-inline">data-bind</code> anywhere — the fields are plain
                inputs, bound server-side to <code class="code-inline">ContactForm</code>. Try an
                invalid email (the browser blocks the request before it is sent) and then a
                two-character message (the server rejects it and patches the form back with
                <code class="code-inline">ModelState</code> errors).
            </p>

            @if (TempData["ContactSent"] is string sentMessage)
            {
                <div class="alert alert-info">@sentMessage</div>
            }

            <partial name="_ContactForm" model="Model"/>

            @* Success responses are inner-patched in here. *@
            <div id="contact-result"></div>
        </div>

        @* ── 2. selector ───────────────────────────────────────────────────── *@
        <div class="card space-y-3">
            <h2 class="card-title">2. Submitting a form from outside it</h2>
            <p class="text-sm text-gray-600 dark:text-gray-300">
                This button is not inside the form. The <code class="code-inline">selector</code>
                option tells Datastar which form to serialise, so any element anywhere on the page
                can submit it.
            </p>
            <button name="Source" value="outside button (selector)" class="btn-secondary"
                    data-on:click="@@post('/Home/Contact', {contentType: 'form', selector: '#contact-form'})">
                Send the form above
            </button>
        </div>

        @* ── 3 + 4. The JSON side ──────────────────────────────────────────── *@
        <div data-signals="{draft: {title: '', body: ''}, _scratch: 'local only', received: '', receivedAt: ''}"
             class="space-y-6">

            <div class="card space-y-4">
                <h2 class="card-title">3. Sending only some signals (@@put + filterSignals)</h2>
                <p class="text-sm text-gray-600 dark:text-gray-300">
                    By default every signal is sent on every request. With
                    <code class="code-inline">filterSignals</code> you send a subset — here only
                    <code class="code-inline">draft.*</code>, which leaves out the page-wide
                    <code class="code-inline">$csrf</code>. Signals whose name starts with
                    <code class="code-inline">_</code> are excluded by default, which is how
                    <code class="code-inline">$_scratch</code> stays client-side.
                    The server echoes the raw request body back with
                    <code class="code-inline">ReadSignalsAsync()</code>.
                </p>

                <div>
                    <label class="form-label">Draft title</label>
                    <input class="form-input" data-bind:draft.title placeholder="Draft title…"/>
                </div>

                <button class="btn-primary w-full"
                        data-on:click="@@put('/api/draft', {filterSignals: {include: /^draft\./}, headers: {'X-CSRF-TOKEN': $csrf}})"
                        data-indicator:saving
                        data-attr:disabled="$saving">
                    Save draft (PUT)
                </button>

                <div data-show="$received">
                    <p class="card-label">Body the server received at <span data-text="$receivedAt"></span></p>
                    <pre class="log-pane mt-1" data-text="$received"></pre>
                </div>
            </div>

            <div class="card space-y-3">
                <h2 class="card-title">4. A debounced request with no SSE at all</h2>
                <p class="text-sm text-gray-600 dark:text-gray-300">
                    <code class="code-inline">data-on:input__debounce.500ms</code> waits until you
                    stop typing. <code class="code-inline">/api/draft/preview</code> is an ordinary
                    MVC action — it never touches <code class="code-inline">IDatastarService</code>.
                    It binds the signals with <code class="code-inline">[FromSignals(Path = "draft")]</code>
                    and returns <code class="code-inline">text/html</code>; the
                    <code class="code-inline">datastar-selector</code> and
                    <code class="code-inline">datastar-mode</code> response headers tell Datastar
                    where to put it.
                </p>
                <div>
                    <label class="form-label">Draft body</label>
                    <textarea class="form-input" rows="3" data-bind:draft.body
                              data-on:input__debounce.500ms="@@get('/api/draft/preview', {filterSignals: {include: /^draft\./}})"
                              placeholder="Type here — the preview follows 500ms after you stop…"></textarea>
                </div>
                <div id="preview" class="rounded-md border border-dashed border-gray-300 p-4 dark:border-gray-600">
                    <p class="text-sm text-gray-400 dark:text-gray-500">The preview appears here.</p>
                </div>
            </div>
        </div>
    </div>
</div>