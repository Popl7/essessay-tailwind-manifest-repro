@{
    ViewData["Title"] = "Home";
}

<div class="max-w-lg w-full rounded-2xl border-4 border-emerald-500 bg-white p-10 shadow-xl">
    <h1 class="text-3xl font-bold text-emerald-600">✅ Tailwind CSS is loaded</h1>
    <p class="mt-4 text-slate-600">
        If this box is white with a green border, and this paragraph is grey
        rather than default black-on-white serif text, then
        <code class="rounded bg-slate-100 px-1 py-0.5 text-sm">wwwroot/css/site.css</code>
        loaded successfully and got a route in
        <code class="rounded bg-slate-100 px-1 py-0.5 text-sm">Essessay.staticwebassets.endpoints.json</code>.
    </p>
    <p class="mt-4 text-sm text-slate-400">
        Unstyled page instead? That's
        <a class="underline" href="https://github.com/dotnet/aspnetcore/issues/68641">dotnet/aspnetcore#68641</a>.
    </p>
</div>
