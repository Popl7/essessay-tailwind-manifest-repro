@{
    ViewData["Title"] = "Round Trip";
}

<div class="mx-auto max-w-xl">
    <h1 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">Server round-trip on signals</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-300">
        The form's signals are POSTed to the server, read typed with
        <code class="rounded bg-gray-100 px-1 py-0.5 text-blue-600 dark:bg-gray-800">ReadSignalsAsync&lt;T&gt;()</code>,
        and the server updates a signal back with
        <code class="rounded bg-gray-100 px-1 py-0.5 text-blue-600 dark:bg-gray-800">PatchSignalsAsync()</code>.
    </p>

    <div class="card mt-6 space-y-4" data-signals="{name: '', style: 'formal', greeting: ''}">
        <div>
            <label class="form-label">Your name</label>
            <input class="form-input" data-bind:name placeholder="Type your name…" />
        </div>
        <div>
            <label class="form-label">Style</label>
            <select class="form-input" data-bind:style>
                <option value="formal">Formal</option>
                <option value="casual">Casual</option>
            </select>
        </div>

        <button class="btn-primary w-full"
                data-on:click="@@post('/api/greet', {headers: {'X-CSRF-TOKEN': $csrf}})"
                data-indicator:loading
                data-attr:disabled="$loading">
            Greet me
        </button>

        <p class="text-lg font-semibold text-gray-900 dark:text-gray-100"
           data-show="$greeting"
           data-text="$greeting"></p>
    </div>
</div>
