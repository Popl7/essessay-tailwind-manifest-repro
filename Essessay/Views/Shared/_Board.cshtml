@model IReadOnlyList<Essessay.Models.BoardCard>

@* The whole board. Sent on a first connect, or when a client is too far behind
   to be caught up with individual patches. *@
<div id="board" class="grid gap-4 sm:grid-cols-3">
    @foreach (var column in Enum.GetValues<Essessay.Models.BoardColumn>())
    {
        var vm = new Essessay.Models.BoardColumnViewModel(
            column,
            Model.Where(c => c.Column == column).OrderBy(c => c.Id).ToList());
        <partial name="_BoardColumn" model="vm"/>
    }
</div>
