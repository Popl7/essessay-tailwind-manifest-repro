@model Essessay.Models.BoardCard

@* Rendered once by whoever made the change, then broadcast to every client. *@
<div id="card-@Model.Id" class="rounded-md border border-gray-200 bg-white p-3 shadow-sm dark:border-gray-700 dark:bg-gray-800">
    <p class="text-sm text-gray-900 dark:text-gray-100">@Model.Text</p>
    <div class="mt-2 flex items-center justify-between gap-2">
        <span class="text-xs text-gray-400 dark:text-gray-500">
            @Model.Author · @Model.UpdatedAt.ToString("HH:mm:ss")
        </span>
        <div class="flex shrink-0 items-center gap-2">
            @if (Model.Column != Essessay.Models.BoardColumn.Todo)
            {
                <button class="nav-link-top cursor-pointer" title="Move left"
                        data-on:click="@@patch('/api/board/cards/@Model.Id/move?direction=-1', {headers: {'X-CSRF-TOKEN': $csrf}})">←</button>
            }
            @if (Model.Column != Essessay.Models.BoardColumn.Done)
            {
                <button class="nav-link-top cursor-pointer" title="Move right"
                        data-on:click="@@patch('/api/board/cards/@Model.Id/move?direction=1', {headers: {'X-CSRF-TOKEN': $csrf}})">→</button>
            }
            <button class="nav-link-top cursor-pointer" title="Delete"
                    data-on:click="@@delete('/api/board/cards/@Model.Id', {headers: {'X-CSRF-TOKEN': $csrf}})">🗑</button>
        </div>
    </div>
</div>
