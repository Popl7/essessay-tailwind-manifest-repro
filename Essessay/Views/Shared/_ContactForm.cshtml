@model Essessay.Models.ContactForm

@*
    A plain MVC form. The form tag helper emits the hidden antiforgery field, and
    `contentType: 'form'` posts the whole form — token included — so no
    X-CSRF-TOKEN header is needed here.

    `data-on:submit` needs no __prevent: Datastar always calls preventDefault() for
    a submit event on a <form>. With JavaScript disabled the attribute does nothing
    and the browser posts to asp-action instead, which the server also handles.
*@
<form id="contact-form" method="post" asp-controller="Home" asp-action="Contact"
      class="space-y-4"
      data-on:submit="@@post('/Home/Contact', {contentType: 'form'})"
      data-indicator:sending>

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div>
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-input" required maxlength="60" placeholder="Ada Lovelace"/>
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div>
        <label asp-for="Email" class="form-label"></label>
        @* type=email + required are checked by the browser first: Datastar calls
           checkValidity() and skips the request entirely if the form is invalid. *@
        <input asp-for="Email" type="email" class="form-input" required placeholder="ada@@example.com"/>
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div>
        <label asp-for="Message" class="form-label"></label>
        <textarea asp-for="Message" rows="3" class="form-input" placeholder="At least 10 characters…"></textarea>
        <span asp-validation-for="Message" class="field-error"></span>
    </div>

    @* The submitter's name/value is appended to the form data, so the server can
       tell which button was used. *@
    <button type="submit" name="Source" value="inline submit button"
            class="btn-primary w-full" data-attr:disabled="$sending">
        Send
    </button>
</form>