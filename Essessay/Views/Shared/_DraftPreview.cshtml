@model Essessay.Models.DraftSignals

@* Returned as a plain text/html response (no SSE) and inner-patched into #preview
   using the datastar-selector / datastar-mode response headers. *@
<p class="card-label">Rendered by the server at @DateTimeOffset.Now.ToString("HH:mm:ss")</p>
<h3 class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">
    @(string.IsNullOrWhiteSpace(Model.Title) ? "(untitled)" : Model.Title)
</h3>
<p class="mt-1 whitespace-pre-wrap text-sm text-gray-600 dark:text-gray-300">
    @(string.IsNullOrWhiteSpace(Model.Body) ? "(nothing typed yet)" : Model.Body)
</p>
<p class="mt-2 text-xs text-gray-400 dark:text-gray-500">@(Model.Body?.Length ?? 0) characters</p>