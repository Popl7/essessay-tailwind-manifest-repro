@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Sets the antiforgery cookie and gives us the request token to expose to Datastar.
    var xsrf = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Essessay</title>
    @* Apply the saved theme before first paint to avoid a flash of the wrong theme. *@
    <script>
        if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
@*
    Connection state lives on <body> so every page has it. Two independent signals,
    because they fail differently: `online` is the device's own radio (airplane mode,
    a tunnel, a dead cell), `reachable` is whether requests are actually landing —
    which catches the captive-portal case where the phone insists it is online.

    `online` is seeded from navigator.onLine rather than `true`, so a page restored
    from the bfcache while offline shows the banner immediately instead of waiting
    for an event that already fired.
*@
<body class="flex min-h-full flex-col bg-gray-50 text-gray-900 dark:bg-gray-900 dark:text-gray-100"
      data-signals="{csrf: '@xsrf', net: {online: navigator.onLine, reachable: true, restored: false}}"
      data-on:offline__window="$net.online = false; $net.restored = false"
      data-on:online__window="$net.online = true; $net.reachable = true; $net.restored = true; setTimeout(() => $net.restored = false, 4000)"
      data-on:datastar-fetch="window.watchReachability(evt, ok => $net.reachable = ok)">

@*
    Sticky, so it pushes the page down rather than covering the nav. aria-live is
    polite: losing signal should not interrupt whatever a screen reader is saying.
*@
<div class="connection-banner connection-banner-down" role="status" aria-live="polite"
     data-show="!$net.online || !$net.reachable"
     data-text="$net.online ? 'Can’t reach the server — retrying…' : 'You’re offline. Changes won’t be sent until you reconnect.'">
</div>
<div class="connection-banner connection-banner-up" role="status" aria-live="polite"
     data-show="$net.restored && $net.online && $net.reachable">
    Back online.
</div>
<header class="border-b border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
    <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-y-2 px-4 py-3">
        <a class="text-lg font-semibold text-gray-900 dark:text-white" asp-area="" asp-controller="Home" asp-action="Index">Essessay</a>
        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Fragment">Get Data</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="LiveStream">Live Stream</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Signals">Signals</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="RoundTrip">Round Trip</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Feed">Feed</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Todos">Todos</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Forms">Forms</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Polling">Polling</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Errors">Errors</a>
            <a class="nav-link-top" asp-area="" asp-controller="Home" asp-action="Board">Board</a>
        </div>
        <div class="flex items-center gap-4">
            <div class="w-2"></div>
            <button type="button"
                    title="Toggle dark mode"
                    aria-label="Toggle dark mode"
                    data-on:click="localStorage.theme = document.documentElement.classList.toggle('dark') ? 'dark' : 'light'"
                    class="nav-link-top cursor-pointer">
                🌓
            </button>
            <div class="w-2"></div>
            <partial name="_LoginPartial"/>
        </div>
    </nav>
</header>

<main role="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-6">
    @RenderBody()
</main>

<footer class="border-t border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
    <div class="mx-auto max-w-5xl px-4 py-3 text-xs text-gray-500 dark:text-gray-400">
        &copy; 2026 - Essessay
    </div>
</footer>

@* Toasts appended here by window.showToast (triggered from the server via ExecuteScriptAsync). *@
<div id="toast-container" class="fixed bottom-4 right-4 z-50 flex flex-col items-end gap-2"></div>
<script>
    /*
        Reachability, folded out of the banner's data-on expression to keep it readable.
        Reports true/false through `report` for whoever is holding $net.reachable.

        The event types are less obvious than they look, and each of the tempting reads
        is wrong:

        - `error` does NOT fire when a request fails to land. It only fires when the
          server answered with HTTP >= 400, and then carries argsRaw.status. A dead
          socket produces `retrying` and nothing else — so keying off `error` detects
          only the case where the connection is fine.
        - `retrying` alone does not mean trouble either: a 500 is retried exactly like
          a dead socket. What separates them is whether a status came back first, which
          is what `sawStatus` tracks (reset per request by `started`).
        - `finished` fires when a request *ends*, including one that just exhausted its
          retries against a server that is gone, so it is no evidence of success.

        Losing a stream is reported late, on a timer: `retry: 'always'` streams like the
        board's reconnect routinely, and a banner that blinks on every reconnect is worse
        than no banner. Coming back is reported immediately.
    */
    window.watchReachability = (function () {
        var sawStatus = false, pending = null;
        var GRACE_MS = 3000;

        return function (evt, report) {
            var type = evt.detail.type, status = evt.detail.argsRaw.status;
            if (type === 'started') sawStatus = false;
            if (type === 'error') sawStatus = Boolean(status);

            var reachable = null; // null: this event says nothing either way.
            if (type.startsWith('datastar-')) reachable = true;         // a patch arrived
            else if (type === 'error') reachable = Boolean(status);      // the server answered
            else if (type === 'retrying' || type === 'retries-failed') reachable = sawStatus;
            if (reachable === null) return;

            if (reachable) {
                clearTimeout(pending);
                pending = null;
                report(true);
            } else if (!pending) {
                // Arm once and leave it armed. Re-arming per retry would push the
                // deadline back forever, since retries keep arriving inside the grace.
                pending = setTimeout(function () { report(false); }, GRACE_MS);
            }
        };
    })();

    window.showToast = function (message, type) {
        var c = document.getElementById('toast-container');
        if (!c) return;
        var el = document.createElement('div');
        el.textContent = message;
        el.className = 'rounded-md px-4 py-2 text-sm font-medium text-white shadow-lg ' +
            (type === 'error' ? 'bg-red-600' : 'bg-gray-900 dark:bg-gray-700');
        c.appendChild(el);
        setTimeout(function () { el.remove(); }, 2500);
    };
</script>

<script type="module" src="~/lib/datastar/datastar.js" asp-append-version="true"></script>
@* jQuery is only needed by unobtrusive validation; _ValidationScriptsPartial pulls it in. *@
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
