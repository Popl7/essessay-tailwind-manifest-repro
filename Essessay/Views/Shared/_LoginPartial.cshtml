@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<div class="flex items-center gap-4">
    @if (SignInManager.IsSignedIn(User))
    {
        <a class="nav-link-top" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">@User.Identity?.Name</a>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link-top">Logout</button>
        </form>
    }
    else
    {
        <a class="nav-link-top" asp-area="Identity" asp-page="/Account/Register">Register</a>
        <a class="nav-link-top" asp-area="Identity" asp-page="/Account/Login">Login</a>
    }
</div>