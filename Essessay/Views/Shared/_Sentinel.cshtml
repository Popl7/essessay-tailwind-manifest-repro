@model int?

@* When there's a next page, this element re-triggers @get as it scrolls into view. *@
@if (Model is int next)
{
    <div id="sentinel" data-on-intersect="@@get('/api/items?page=@next')" class="h-8"></div>
}
else
{
    <div id="sentinel" class="py-4 text-center text-sm text-gray-400 dark:text-gray-500">— end —</div>
}
