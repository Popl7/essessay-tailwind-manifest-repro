@* Pure client-side Datastar reactivity — no server request involved. *@
<div class="card mt-4 space-y-5"
     data-signals="{name: '', message: ''}"
     data-computed:remaining="140 - $message.length">

    @* data-bind: two-way binding between the input and the `name` signal *@
    <div>
        <label class="form-label">Your name</label>
        <input class="form-input" data-bind:name placeholder="Type your name…" />
    </div>

    @* data-text: reactive text bound to a signal expression (template literal) *@
    <p class="text-lg font-semibold text-gray-900 dark:text-gray-100" data-text="`Hello, ${$name || 'stranger'}!`"></p>

    @* Two-way sync: a second input bound to the SAME signal stays in lock-step *@
    <div>
        <label class="form-label">Same signal, second input — edits stay in sync</label>
        <input class="form-input" data-bind:name />
    </div>

    @* data-computed (`remaining`) + data-class: reactive derived value and classes *@
    <div>
        <label class="form-label">Message</label>
        <textarea class="form-input" rows="3" data-bind:message placeholder="Say something…"></textarea>
        <p class="mt-1 text-xs" data-class="{'text-red-600': $remaining < 0, 'text-gray-400': $remaining >= 0}">
            <span data-text="$message.length"></span>/140 —
            <span data-text="$remaining >= 0 ? `${$remaining} left` : `${-$remaining} over`"></span>
        </p>
    </div>
</div>
