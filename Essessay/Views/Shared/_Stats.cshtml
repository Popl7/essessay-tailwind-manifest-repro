@model Essessay.Models.StatsViewModel

@*
    Re-rendered on every poll and morphed over the previous #stats. The two boxes at
    the bottom show what morphing does — and how to opt out of it.
*@
<div id="stats" class="space-y-4">
    <div class="grid grid-cols-2 gap-4">
        <div>
            <p class="card-label">Requests served</p>
            <p class="mt-1 font-mono text-2xl font-semibold text-gray-900 dark:text-gray-100">@Model.Requests</p>
        </div>
        <div>
            <p class="card-label">Server time</p>
            <p class="mt-1 font-mono text-2xl font-semibold text-gray-900 dark:text-gray-100">@Model.ServerTime.ToString("HH:mm:ss")</p>
        </div>
    </div>

    <div>
        <p class="card-label">Load — width comes from the patched <code class="code-inline">$stats.load</code> signal</p>
        @* data-style keeps an inline CSS property in sync with an expression. *@
        <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
            <div class="h-2 rounded-full bg-blue-600 transition-all duration-500"
                 data-style:width="`${$stats.load}%`"></div>
        </div>
        <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">
            <span data-text="$stats.load"></span>% (server said @Model.Load%)
        </p>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
        @* The server renders this closed every time. data-preserve-attr tells the
           morph to leave the live `open` attribute alone, so it stays open. *@
        <details class="rounded-md border border-green-300 p-3 text-sm dark:border-green-800"
                 data-preserve-attr="open">
            <summary class="cursor-pointer font-medium">Survives the poll (data-preserve-attr="open")</summary>
            <p class="mt-2 text-gray-600 dark:text-gray-300">Still open — the morph skipped the open attribute.</p>
        </details>

        @* No protection: the server's closed markup wins on every poll. *@
        <details class="rounded-md border border-red-300 p-3 text-sm dark:border-red-800">
            <summary class="cursor-pointer font-medium">Snaps shut every poll (unprotected)</summary>
            <p class="mt-2 text-gray-600 dark:text-gray-300">You won't see this for long.</p>
        </details>
    </div>

    <div class="grid gap-3 sm:grid-cols-2">
        @* data-ignore-morph: the whole subtree is left untouched by the morph, so
           whatever the client wrote into it on first load stays there. *@
        <div class="rounded-md border border-green-300 p-3 text-sm dark:border-green-800" data-ignore-morph>
            <p class="card-label">data-ignore-morph</p>
            <p class="mt-1 font-mono" data-init="el.textContent = 'client wrote ' + new Date().toLocaleTimeString()">—</p>
        </div>

        <div class="rounded-md border border-red-300 p-3 text-sm dark:border-red-800">
            <p class="card-label">Morphed normally</p>
            <p class="mt-1 font-mono">server wrote @Model.ServerTime.ToString("HH:mm:ss")</p>
        </div>
    </div>
</div>
