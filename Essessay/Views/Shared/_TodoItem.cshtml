@model Essessay.Services.Todo

<div id="todo-@Model.Id" class="flex items-center justify-between gap-3 rounded-md border border-gray-200 bg-white px-3 py-2 dark:border-gray-700 dark:bg-gray-800">
    <span class="@(Model.Done ? "text-gray-400 line-through dark:text-gray-500" : "text-gray-900 dark:text-gray-100")">@Model.Text</span>
    <div class="flex items-center gap-3">
        <button class="nav-link-top"
                title="Toggle done"
                data-on:click="@@patch('/api/todos/@Model.Id/toggle', {headers: {'X-CSRF-TOKEN': $csrf}})">
            @(Model.Done ? "↩" : "✓")
        </button>
        <button class="nav-link-top"
                title="Delete"
                data-on:click="@@delete('/api/todos/@Model.Id', {headers: {'X-CSRF-TOKEN': $csrf}})">
            🗑
        </button>
    </div>
</div>
